<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>

        <script type="importmap"></script>

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" integrity="..." crossorigin="anonymous"> *@
        @* <link rel="stylesheet" href="~/TheKhurshidInstituteApp.styles.css" asp-append-version="true" /> *@
        <link rel="stylesheet" href="~/css/custom_site_style.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link rel="icon" type="image/png" href="~/images/logo-shield.png" />
    </head>

    <body class="khurshid-body">
        <header>
            @* <a class="visually-hidden-focusable sr-only" href="#mainContent">Skip to main content</a> *@

            <nav class="navbar navbar-expand-sm navbar-dark fixed-top khurshid-header" role="navigation" aria-label="Main navigation">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                        <img src="~/images/TKS Wordmark Logo.jpeg" alt="The Khurshid Institute" class="khurshid-nav-logo">
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="mainNavbar">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="aboutDropdown"
                                    role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    About Us
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
                                    <li><a class="dropdown-item" asp-page="/CoreValues">Core Values</a></li>
                                    <li><a class="dropdown-item" asp-page="/CodeOfConduct">Code of Conduct</a></li>
                                    <li><a class="dropdown-item" asp-page="/GovEthicsPolicy">Governance and Ethics Policy</a></li>
                                    <li><a class="dropdown-item" asp-page="/EnvStatement">Accountability Alignment</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="mediaDropdown"
                                    role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Media
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="mediaDropdown">
                                    <li><a class="dropdown-item" asp-page="/News">Recent News</a></li>
                                    <li><a class="dropdown-item" asp-page="/RelevantArticles">Articles/Editorials</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="otherDropdown"
                                    role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Other Services
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="otherDropdown">
                                    <li><a class="dropdown-item" asp-page="/Other">Other</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="khurshid-content">
            <div class="container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

        <footer class="khurshid-footer">
            <div class="container py-4">
                <div class="khurshid-footer-contact">
                    <span>
                        <i class="bi bi-geo-alt-fill"></i> Greater Toronto Area, ON, Canada
                    </span>
                    <span class="footer-separator">|</span>
                    <span>
                        <i class="bi bi-briefcase-fill"></i> Mon.-Fri.: 9.00 am-5.00 pm
                    </span>
                    <span class="footer-separator">|</span>
                    <span>
                        <i class="bi bi-telephone-fill"></i> <a href="tel:+1647-671-3395">647-671-3395</a>
                    </span>
                    <span class="footer-separator">|</span>
                    <span>
                        <i class="bi bi-envelope-fill"></i> <a href="mailto:Samer.T.Khurshid@gmail.com">Samer.T.Khurshid@gmail.com</a>
                    </span>
                </div>
                <div class="khurshid-footer-copy mt-2">
                    &copy; 2026 The Khurshid Institute. All rights reserved.
                </div>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-..." crossorigin="anonymous"></script> *@

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>