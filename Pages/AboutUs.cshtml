@page
@model AboutUsModel
@{
    ViewData["Title"] = "The Khurshid Institute - Mission Statement";
}

<div class="d-flex align-items-center mb-4">
    <h1>Mission Statement</h1>
</div>

<div>
    <p>
        At The Khurshid Institute, our mission is empower public sector organizations with practical, ethical, and accessible digital tools that improve transparency, decision-making, and service delivery — without unnecessary complexity or cost. 
        We aim to achieve this by modernizing public sector decision-making through ethical, data-driven, and accessible technology.
    </p>
    <p>
        Our vision is a public sector where governments make evidence-based decisions, engage communities effectively, and deliver services with clarity, accountability, and trust — enabled by modern, human-centered technology. 
        We aim to achieve this by delivering transparent, accountable, and community-centered governance powered by smart digital tools.
    </p>
</div>
