@page
@model EnvStatementModel
@{
    ViewData["Title"] = "The Khurshid Institute - Our Accountability Alignment for ESG and Public Sector Initiatives";
}

<div class="d-flex align-items-center mb-4">
    <h1>Our Accountability Alignment for ESG and Public Sector Initiatives</h1>
</div>

<div>
    <div>
        <p class="bullet-highlight">Environmental Responsibility</p>
        <p>
            At The Khurshid Institute, we promote digital-first processes that reduce paper usage, administrative duplication, and unnecessary resource consumption. 
            Our solutions support data-driven planning for environmental and sustainability initiatives.
        </p>
    </div>
    <div>
        <p class="bullet-highlight">Social Responsibility</p>
        <p>
            Our platforms improve transparency, equity, and participation by making public information easier to access and by enabling inclusive community engagement. 
            We design with accessibility, language inclusion, and user diversity in mind.
        </p>
    </div>
    <div>
        <p class="bullet-highlight">Governance and Ethics</p>
        <p>
            We uphold strong governance principles through transparent reporting, clear audit trails, ethical data handling, and compliance with public-sector standards. 
            Our advisory approach reinforces accountability, oversight, and evidence-based decision-making.
        </p>
        <p>
            Our work supports strong environmental, social, and governance outcomes by enabling transparent reporting, inclusive engagement, ethical data use, and responsible stewardship of public resources through practical digital solutions.
        </p>
    </div>
</div>